NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only key used to check eligibility for password resets. Never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GROQ_API_KEY=gsk_your-groq-api-key
# Необязательно: по умолчанию используется llama-3.3-70b-versatile.
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile

# Уведомления о новых заявках через Resend.
# Адрес отправителя должен использовать подтверждённый домен в Resend.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=SpottedAI <notifications@your-verified-domain.com>
REGISTRATION_NOTIFICATION_EMAIL=admin@your-school.kz
APP_URL=https://your-production-domain.com
# In Supabase Authentication → URL Configuration → Redirect URLs, add:
# https://your-production-domain.com/**
# For local development, also add: http://localhost:3000/**
